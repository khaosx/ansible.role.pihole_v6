# {{ ansible_managed | comment }}

#!/usr/bin/env bash
set -euo pipefail

DOMAIN="{{ pihole_v6_tls_domain }}"
LIVE_DIR="/etc/letsencrypt/live/${DOMAIN}"
OUT="{{ pihole_v6_tls_pem_path }}"

# Concatenate fullchain + privkey exactly as Pi-hole expects
cat "${LIVE_DIR}/fullchain.pem" "${LIVE_DIR}/privkey.pem" > "${OUT}"

# Ownership & perms — use configured owner/group
chown {{ pihole_v6_tls_pem_owner }}:{{ pihole_v6_tls_pem_group }} "${OUT}"
chmod {{ pihole_v6_tls_pem_mode }} "${OUT}"

# Bounce FTL so it picks up the renewed cert
systemctl restart pihole-FTL